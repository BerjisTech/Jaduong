# --- iOS / Android (React Native, Flutter, etc.) ---
android/.gradle/
android/local.properties
android/app/build/
ios/Pods/
ios/build/
*.xcworkspace
*.xcuserstate
*.xcuserdata/

# --- Unreal Engine (C++ Desktop) ---
# Core autogenerated/build caches
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Visual Studio artifacts generated by UBT/IDE
.vs/
ipch/
*.VC.db
*.VC.opendb
*.sdf
*.suo
*.opensdf
*.log
*.tlog

# Keep code, configs, and project files
!Source/
!Config/
!Plugins/**/Source/**
!*.Target.cs
!*.Build.cs
!*.uproject
!*.uplugin

# Exclude heavy binary assets (can use Git LFS instead)
Content/**
!Content/.gitkeep
!Content/README.md
Plugins/*/Content/**
!Plugins/*/Content/.gitkeep
!Plugins/*/Content/README.md

# Exclude packaged/cooked outputs (if produced under project)
Build/WindowsNoEditor/
Build/LinuxNoEditor/
Build/MacNoEditor/

# --- Docker / Containers ---
.docker/
**/.env.docker

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*

# --- Project asset directories (keep code, ignore heavy assets) ---
# Add a small placeholder like .gitkeep or README.md to keep folders.
assets/**
!assets/.gitkeep
!assets/README.md
media/**
!media/.gitkeep
!media/README.md
uploads/**
!uploads/.gitkeep
!uploads/README.md
storage/**
!storage/.gitkeep
!storage/README.md
data/**
!data/.gitkeep
!data/README.md
datasets/**
!datasets/.gitkeep
!datasets/README.md
public/uploads/**
public/media/**
static/uploads/**
static/media/**

# --- Databases / dumps ---
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.rdb
*.ldb
dump.rdb
backups/

# --- Auto-generated docs / sites ---
docs/_build/
site/
public/build/
static/build/
