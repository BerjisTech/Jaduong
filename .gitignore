Thumbs.db
ehthumbs.db
Icon?
*.swp
*.swo
*.swn
*.tmp
*.bak
*.orig
*.rej

# --- Logs / PIDs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.pid
*.pid.lock

# --- IDE / Editor settings ---
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml
*.sublime-*
*.code-workspace

# --- Environment & secrets ---
.env
.env.*
!.env.example
!.env.sample
*.secret
secrets/
*.key
*.pem
*.p12

# --- Node / JS / TS ---
node_modules/
.pnp*
.npm/
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Build outputs / caches (common JS frameworks)
dist/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/
.astro/
storybook-static/
.eslintcache
coverage/
reports/
lib-cov/
nyc_output/
.nyc_output/

# Keep Unreal's `Build/` folder tracked
!Build/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
.coverage
.coverage.*
htmlcov/
.tox/
.pyre/
.pytype/

# --- Java / Gradle / Maven ---
.gradle/
build/
target/
*.class
hs_err_pid*
.classpath
.project
.settings/

# --- .NET ---
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
